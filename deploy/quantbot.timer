# systemd timer: fire the quantbot pipeline every weekday morning.
#
# The trailing timezone on OnCalendar pins the fire time regardless of the host's
# system clock (requires systemd v251+; check with `systemctl --version`). On older
# systemd, drop the zone here and set the host TZ instead:
#   sudo timedatectl set-timezone Asia/Singapore
#
# Verify what you configured actually resolves to the times you expect:
#   systemd-analyze calendar 'Mon-Fri *-*-* 07:00:00 Asia/Singapore'

[Unit]
Description=Schedule quantbot morning report

[Timer]
# 07:00 Singapore time, Monday through Friday (markets closed on weekends).
OnCalendar=Mon-Fri *-*-* 07:00:00 Asia/Singapore
Persistent=true

[Install]
WantedBy=timers.target
