# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# --- IBKR Flex Web Service ---
# Client Portal -> Performance & Reports -> Flex Queries -> Flex Web Service Configuration
IBKR_FLEX_TOKEN=
# The Query ID of a Flex Query that includes Open Positions + Account Information
IBKR_FLEX_QUERY_ID=

# --- Market data (free tiers) ---
# https://finnhub.io  (free API key)
FINNHUB_KEY=
# https://fred.stlouisfed.org/docs/api/api_key.html  (free API key)
FRED_KEY=

# --- Telegram ---
# Create a bot via @BotFather, then message it once and read chat_id (see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude narrative (optional; falls back to deterministic template if unset) ---
ANTHROPIC_API_KEY=
